# ============================================================================
#  ÁPICE — Configuración del servidor (carpeta public_html)
#  Objetivo: que la app se actualice SOLA para todos los usuarios.
#  - El código (html, js, json) nunca se guarda en caché: siempre se pide lo último.
#  - Las imágenes y fuentes sí se cachean un día (para que cargue rápido).
# ============================================================================

# Forzar HTTPS (conexión segura)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # El dominio raíz muestra la web de presentación (carpeta web/).
  # La app sigue accesible en /index.html (no se renombra ni se mueve).
  # La URL en el navegador queda limpia: se ve "abogadoscatamarca.com".
  RewriteRule ^$ web/index.html [L]
</IfModule>

# Control de caché
<IfModule mod_headers.c>
  # Código de la app: SIEMPRE se revalida contra el servidor (queda fresco),
  # pero si el archivo no cambió, el navegador reutiliza su copia y el servidor
  # responde "304 Sin cambios" (unos bytes) en vez de volver a mandar todo.
  # Baja MUCHO el tráfico y la carga del servidor, sin arriesgar versiones viejas.
  <FilesMatch "\.(html|js|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>
  # El service worker: nunca cachear (para que las actualizaciones lleguen).
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Imágenes, íconos y fuentes: se pueden cachear un día.
  <FilesMatch "\.(svg|png|jpg|jpeg|gif|ico|woff2?|ttf|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
